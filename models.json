{
  "metadata": {
    "version": "3.0.0",
    "description": "Local model catalog. Architecture fields drive the VRAM profiler in scripts/vram-profile.mjs; variants are ranked by bits-per-weight and the context they leave. Identifiers and architectures are checked by tests/catalog.test.mjs against the live HuggingFace and Ollama registries.",
    "checked": "2026-07-26",
    "arch_note": "kv_layers counts only layers that cache KV. For hybrid models it is smaller than the layer count: Qwen3.6-27B runs linear attention on 48 of 64 layers (full_attention_interval 4), so only 16 layers cache."
  },
  "default_model": "qwen2.5-coder-7b",
  "models": [
    {
      "id": "qwen3.6-27b",
      "display_name": "Qwen3.6 27B",
      "context": 262144,
      "reasoning": true,
      "params_b": 27,
      "arch": { "layers": 64, "kv_layers": 16, "kv_heads": 4, "head_dim": 256, "hybrid": true },
      "notes": "Dense 27B with hybrid linear/full attention, Apache-2.0. Only 16 of 64 layers cache KV, so it holds far more context per GB than a conventional 27B.",
      "vllm_args": ["--reasoning-parser", "qwen3"],
      "variants": [
        { "quant": "bf16", "vllm": "Qwen/Qwen3.6-27B" },
        { "quant": "fp8", "vllm": "Qwen/Qwen3.6-27B-FP8" },
        { "quant": "awq4", "vllm": "QuantTrio/Qwen3.6-27B-AWQ", "extra_args": ["--quantization", "awq"] },
        { "quant": "q8_0", "ollama": "qwen3.6:27b-q8_0", "gguf": "unsloth/Qwen3.6-27B-GGUF", "gguf_file": "Qwen3.6-27B-Q8_0.gguf" },
        { "quant": "q6_k", "ollama": "qwen3.6:27b", "gguf": "unsloth/Qwen3.6-27B-GGUF", "gguf_file": "Qwen3.6-27B-Q6_K.gguf" },
        { "quant": "q4_k_m", "ollama": "qwen3.6:27b", "gguf": "unsloth/Qwen3.6-27B-GGUF", "gguf_file": "Qwen3.6-27B-Q4_K_M.gguf" }
      ]
    },
    {
      "id": "qwen3-coder-30b",
      "display_name": "Qwen3 Coder 30B-A3B",
      "context": 262144,
      "params_b": 30.5,
      "arch": { "layers": 48, "kv_layers": 48, "kv_heads": 4, "head_dim": 128 },
      "notes": "Mixture of experts, 3B active. Fast for its size, but all 48 layers cache KV.",
      "variants": [
        { "quant": "bf16", "vllm": "Qwen/Qwen3-Coder-30B-A3B-Instruct" },
        { "quant": "q4_k_m", "ollama": "qwen3-coder:30b" }
      ]
    },
    {
      "id": "qwen2.5-coder-7b",
      "display_name": "Qwen2.5 Coder 7B",
      "context": 32768,
      "params_b": 7.6,
      "arch": { "layers": 28, "kv_layers": 28, "kv_heads": 4, "head_dim": 128 },
      "notes": "Small, proven coding model. Fits almost anything. Good default.",
      "variants": [
        { "quant": "bf16", "vllm": "Qwen/Qwen2.5-Coder-7B-Instruct" },
        { "quant": "awq4", "vllm": "Qwen/Qwen2.5-Coder-7B-Instruct-AWQ", "extra_args": ["--quantization", "awq"] },
        { "quant": "q4_k_m", "ollama": "qwen2.5-coder:7b" }
      ]
    },
    {
      "id": "llama3.1-8b",
      "display_name": "Llama 3.1 8B",
      "context": 131072,
      "params_b": 8,
      "arch": { "layers": 32, "kv_layers": 32, "kv_heads": 8, "head_dim": 128 },
      "notes": "General purpose. The HuggingFace repo is gated: vLLM needs HF_TOKEN and an accepted licence. The Ollama tag is not gated.",
      "variants": [
        { "quant": "bf16", "vllm": "meta-llama/Meta-Llama-3.1-8B-Instruct", "gated": true },
        { "quant": "q4_k_m", "ollama": "llama3.1:8b" }
      ]
    },
    {
      "id": "phi3-mini",
      "display_name": "Phi-3 Mini 3.8B",
      "context": 4096,
      "params_b": 3.8,
      "arch": { "layers": 32, "kv_layers": 32, "kv_heads": 32, "head_dim": 96 },
      "notes": "Smallest useful option, for machines with no GPU worth using. No GQA, so its KV cache is heavy per token despite the small weights.",
      "variants": [
        { "quant": "bf16", "vllm": "microsoft/Phi-3-mini-4k-instruct" },
        { "quant": "q4_k_m", "ollama": "phi3:mini" }
      ]
    }
  ]
}
