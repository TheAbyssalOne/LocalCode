{
  "name": "localcode",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Run OpenCode against models on your own hardware: detect, install, serve, configure, sync.",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "validate": "pnpm run check && pnpm test",
    "setup": "node scripts/setup.mjs",
    "setup:vllm": "node scripts/setup.mjs --provider vllm",
    "setup:ollama": "node scripts/setup.mjs --provider ollama",
    "download-models": "node scripts/download-models.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
