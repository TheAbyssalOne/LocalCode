# OpenCode Local Setup - Environment Template
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Primary model server endpoint ---
# For Ollama:  http://127.0.0.1:11434/v1
# For LM Studio: http://127.0.0.1:1234/v1
# For vLLM:    http://127.0.0.1:8000/v1
LOCAL_API_BASE=http://127.0.0.1:1234/v1

# --- Provider identification ---
OPENCODE_PROVIDER_ID=lmstudio
OPENCODE_PROVIDER_NAME="LM Studio (local)"

# --- Local server authentication (optional) ---
# Most local servers don't require auth. Set if yours does:
# LOCAL_API_KEY=your-local-api-key-here

# --- Cloud provider API keys (set as needed) ---
# Uncomment and fill in for providers you want to use alongside local models.
# Keys are referenced via {env:VAR_NAME} in opencode.json config.

# OpenAI (ChatGPT, GPT-4, etc.)
# OPENAI_API_KEY=sk-proj-...

# Fireworks AI
# FIREWORKS_API_KEY=fw_...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# xAI (Grok)
# XAI_API_KEY=xai-...

# Groq (fast inference)
# GROQ_API_KEY=gsk_...

# Together AI
# TOGETHER_API_KEY=...

# Mistral AI
# MISTRAL_API_KEY=...

# OpenRouter (aggregator for many providers)
# OPENROUTER_API_KEY=sk-or-...

# Alibaba DashScope
# DASHSCOPE_API_KEY=sk-...
# ALIBABA_API_KEY=sk-...

# --- Remote OpenAI-compatible servers ---
# For self-hosted or third-party endpoints on your network:
# REMOTE_API_BASE=https://your-server.com/v1
# REMOTE_API_KEY=...

# --- Tailscale discovery (opt-in) ---
# Enable to discover local model servers across your Tailscale network:
# OPENCODE_TAILSCALE_DISCOVERY=1
# OPENCODE_TAILSCALE_PORTS=1234,8000,8080,11434
